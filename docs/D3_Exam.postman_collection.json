              ],
              "path": [
                "api",
                "v1",
                "admin",
                "exams"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"examScope\": \"trial\",\n  \"certificateId\": \"{{certificateId}}\",\n  \"examCode\": \"PM-MOCK-{{$timestamp}}\",\n  \"examType\": \"placement_test\",\n  \"examTitle\": \"Postman mock test\",\n  \"durationMinutes\": 30,\n  \"passingScore\": 50,\n  \"maxAttempts\": 3,\n  \"showAnswers\": true,\n  \"showScore\": true,\n  \"isFree\": true,\n  \"recommendedLevel\": \"B1\"\n}"
            },
            "description": "certificateId mặc định là chứng chỉ trong file init D3_exam_sample_data.sql"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('examId', pm.response.json().result.exam.examId);"
