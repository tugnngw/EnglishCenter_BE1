# =====================================================
# Bien moi truong cho EnglishCenter
#   - File nay la MAU. Copy thanh .env roi dien gia tri that
#   - Spring Boot tu doc file nay khi chay tu thu muc goc project
#   - docker compose cung tu doc file nay
# =====================================================

# ===== Database (PostgreSQL) =====
DB_HOST=localhost
DB_PORT=5432
DB_NAME=englishcenter
DB_USERNAME=postgres
DB_PASSWORD=your_db_password

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379

# ===== JWT =====
# Toi thieu 64 ky tu (HS512). Tao key moi: openssl rand -hex 32
JWT_SIGNER_KEY=change-me-to-a-random-string-at-least-64-characters-long
