# =====================================================
# Bien moi truong cho EnglishCenter
#   - File nay la MAU. Copy thanh .env roi dien gia tri that
#   - Chay IDE: can nap cac bien nay vao Run Configuration
#   - docker compose cung tu doc file nay
# =====================================================

# ===== Database (PostgreSQL) =====
DB_HOST=localhost
DB_PORT=5432
DB_NAME=englishcenter
DB_USERNAME=postgres
DB_PASSWORD=your_db_password

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379

# ===== JWT =====
# Toi thieu 64 ky tu (HS512). Tao key moi: openssl rand -hex 32
JWT_SIGNER_KEY=change-me-to-a-random-string-at-least-64-characters-long

# ===== SePay: QR + bank webhook (Test mode first) =====
SEPAY_WEBHOOK_SECRET=
SEPAY_BANK_CODE=MBBank
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=
SEPAY_PAYMENT_PREFIX=EC
SEPAY_ORDER_EXPIRY_MINUTES=15
