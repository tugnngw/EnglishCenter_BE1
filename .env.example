# =====================================================
# Bien moi truong cho EnglishCenter
#   - File nay la MAU. Copy thanh .env roi dien gia tri that
#   - Chay IDE: can nap cac bien nay vao Run Configuration
#   - docker compose cung tu doc file nay
# =====================================================

# ===== Database (PostgreSQL) =====
DB_HOST=localhost
DB_PORT=5432
DB_NAME=englishcenter
DB_USERNAME=postgres
DB_PASSWORD=your_db_password

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379

# ===== JWT =====
# Toi thieu 64 ky tu (HS512). Tao key moi: openssl rand -hex 32
JWT_SIGNER_KEY=change-me-to-a-random-string-at-least-64-characters-long

# ===== SePay: QR + bank webhook (Test mode first) =====
SEPAY_WEBHOOK_SECRET=
SEPAY_BANK_CODE=MBBank
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=
SEPAY_PAYMENT_PREFIX=EC
SEPAY_ORDER_EXPIRY_MINUTES=15

# AI cham Writing / Speaking + doc file de (Claude - Anthropic API)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5


# ===== Cloudinary: luu file bai tap, tai lieu dinh kem =====
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Khoa ky URL co thoi han (authenticated) - 64 ky tu hex, sinh rieng khoi API Secret
CLOUDINARY_AUTH_KEY=
# Thoi han URL xem file bai nop (giay)
CLOUDINARY_URL_TTL_SECONDS=900

# Email local: Gmail SMTP; Render Free uses Brevo SMTP on port 2525.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=EnglishHub
